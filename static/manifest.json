{
    "manifest_version": 3,
    "name": "Boca",
    "description": "You talk, therefore I am. Comments on any web page, carried by public Nostr relays.",
    "version": "2.0.0",
    "minimum_chrome_version": "120",
    "icons": {
        "16": "icons/boca16.png",
        "32": "icons/boca32.png",
        "48": "icons/boca48.png",
        "128": "icons/boca128.png"
    },
    "action": {
        "default_title": "Open Boca for this page"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "side_panel": {
        "default_path": "panel.html"
    },
    "permissions": ["sidePanel", "storage", "tabs", "scripting"],
    "optional_host_permissions": ["<all_urls>"]
}
